# ===== TelematicsHub Backend — Environment Variables =====
# Copy this file to .env and fill in your values

# ---- Application ----
APP_NAME=TelematicsHub
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# ---- Database ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/telematicshub
# For SQLite (no PostgreSQL needed for dev):
# DATABASE_URL=sqlite:///./telematicshub.db

# ---- Security / JWT ----
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- MQTT Broker ----
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=telematicshub/vehicles

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Alert Thresholds ----
FUEL_ALERT_THRESHOLD=25
ENGINE_TEMP_MAX=90
ALCOHOL_THRESHOLD=0.03
SPEED_LIMIT=100

# ---- Scheduler ----
DOCUMENT_REMINDER_DAYS=30,7,1
